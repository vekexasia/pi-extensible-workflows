{
  "name": "pi-extensible-workflows",
  "version": "5.19.1",
  "description": "Deterministic multi-agent workflow orchestration for Pi",
  "homepage": "https://vekexasia.github.io/pi-extensible-workflows/",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/vekexasia/pi-extensible-workflows.git",
    "directory": "packages/core"
  },
  "type": "module",
  "keywords": [
    "pi-package",
    "pi",
    "workflow",
    "multi-agent",
    "orchestration",
    "automation"
  ],
  "exports": {
    ".": "./dist/src/index.js",
    "./persistence": "./dist/src/persistence.js",
    "./types": "./dist/src/types.js",
    "./utils": "./dist/src/utils.js",
    "./process": "./dist/src/process-launcher.js",
    "./budget": "./dist/src/budget.js",
    "./validation": "./dist/src/validation.js",
    "./roles": "./dist/src/roles.js",
    "./registry": "./dist/src/registry.js",
    "./runtime": "./dist/src/runtime/index.js",
    "./trajectory": "./dist/trajectory/index.js"
  },
  "files": [
    "dist/src",
    "dist/starter",
    "dist/subagents",
    "dist/trajectory",
    "!dist/**/test/**",
    "!dist/**/*.test.*",
    "src",
    "starter",
    "trajectory/index.ts",
    "trajectory/src",
    "subagents/index.ts",
    "subagents/src",
    "subagents/README.md",
    "skills",
    "examples",
    "CHANGELOG.md",
    "trajectory/vendor/archify/LICENSE",
    "!dist/trajectory/src/assets/semantic-map.html",
    "!dist/trajectory/src/assets/semantic-map.js",
    "!dist/trajectory/src/assets/semantic-map.css",
    "!trajectory/src/assets/semantic-map.html",
    "!trajectory/src/assets/semantic-map.js",
    "!trajectory/src/assets/semantic-map.css",
    "!trajectory/src/semantic-map.css"
  ],
  "scripts": {
    "build": "node ../../scripts/workspace-build.mjs core",
    "lint": "eslint .",
    "test": "npm run test:layout && npm run build && npm run test:widget && npm run test:run && npm run test:herdr && npm run test:subagents",
    "test:layout": "node --test --test-timeout=10000 --test-force-exit test/workspace-layout.test.mjs",
    "test:subagents": "node ../../scripts/run-workspace-tests.mjs --workspace core --pattern subagents/test/index.test.mjs --agent-dir --unset-herdr --timeout 30000",
    "test:widget": "node ../../scripts/run-workspace-tests.mjs --workspace core --pattern test/background-widget.test.mjs --unset-herdr --timeout 30000",
    "test:run": "node ../../scripts/run-workspace-tests.mjs --workspace core --pattern=dist/test/**/*.test.js --pattern=dist/trajectory/test/**/*.test.js --exclude=dist/test/navigator.test.js --agent-dir --unset-herdr --expose-gc",
    "test:herdr": "node ../../scripts/run-herdr-tests.mjs",
    "acceptance": "npm run build && node ../../scripts/run-workspace-tests.mjs --workspace core --pattern dist/test/runtime-acceptance.test.js --agent-dir --unset-herdr --expose-gc",
    "evals": "npm run build && node dist/evals/src/workflow-evals.js",
    "evals:ambient": "node -e \"if (process.env.PI_WORKFLOW_EVAL_AMBIENT !== '1') { console.error('Ambient Tier D evals are opt-in. Set PI_WORKFLOW_EVAL_AMBIENT=1 to run them.'); process.exit(1); }\" && npm run build && node dist/evals/src/ambient-workflow-evals.js",
    "prepack": "npm run build && node ../../scripts/stage-core-changelog.mjs stage",
    "postpack": "node ../../scripts/stage-core-changelog.mjs clean"
  },
  "pi": {
    "extensions": [
      "./dist/src/index.js",
      "./dist/starter/index.js",
      "./dist/subagents/index.js",
      "./dist/trajectory/index.js"
    ],
    "prompts": [
      "./starter/prompts"
    ],
    "image": "https://raw.githubusercontent.com/vekexasia/pi-extensible-workflows/main/assets/banner.svg"
  },
  "peerDependencies": {
    "@earendil-works/pi-ai": "*",
    "@earendil-works/pi-coding-agent": ">=0.99.0",
    "@earendil-works/pi-tui": "*",
    "typebox": "*"
  },
  "devDependencies": {
    "@earendil-works/pi-ai": "1.0.3",
    "@earendil-works/pi-coding-agent": "1.0.3",
    "@earendil-works/pi-server": "1.0.3",
    "@earendil-works/pi-tui": "1.0.3",
    "@eslint/js": "10.0.1",
    "@types/node": "24.12.4",
    "esbuild": "^0.28.2",
    "eslint": "10.0.3",
    "typescript": "5.9.3",
    "typescript-eslint": "8.63.0"
  },
  "engines": {
    "node": ">=22.19.0"
  },
  "license": "MIT",
  "dependencies": {
    "acorn": "^8.17.0",
    "minimatch": "^10.2.5"
  },
  "publishConfig": {
    "access": "public"
  }
}
