{
  "name": "@piewf/cli",
  "version": "5.19.1",
  "description": "CLI for pi-extensible-workflows",
  "homepage": "https://vekexasia.github.io/pi-extensible-workflows/",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/vekexasia/pi-extensible-workflows.git",
    "directory": "packages/cli"
  },
  "type": "module",
  "exports": {
    ".": "./dist/src/cli.js",
    "./pi-role": "./dist/src/pi-role.js"
  },
  "bin": {
    "piewf": "./dist/src/cli.js",
    "pi-role": "./dist/src/pi-role.js"
  },
  "files": [
    "dist/src"
  ],
  "scripts": {
    "build": "node ../../scripts/workspace-build.mjs cli",
    "inspect": "node dist/src/cli.js inspect",
    "test": "npm run build && npm run test:run",
    "test:run": "node ../../scripts/run-workspace-tests.mjs --workspace cli --pattern=dist/test/**/*.test.js --unset-herdr --timeout 300000",
    "lint": "eslint .",
    "prepack": "npm run build"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@types/node": "24.12.4",
    "esbuild": "^0.28.2",
    "eslint": "10.0.3",
    "typescript": "5.9.3",
    "typescript-eslint": "8.63.0"
  },
  "engines": {
    "node": ">=22.19.0"
  },
  "license": "MIT",
  "dependencies": {
    "@earendil-works/pi-ai": "1.0.3",
    "@earendil-works/pi-coding-agent": "1.0.3",
    "@earendil-works/pi-server": "1.0.3",
    "@earendil-works/pi-tui": "1.0.3",
    "pi-extensible-workflows": "5.19.1",
    "typebox": "1.3.7"
  },
  "publishConfig": {
    "access": "public"
  }
}
